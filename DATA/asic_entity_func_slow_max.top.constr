##
## Top level primetime constraint for design asic_entity
##
create_clock -name {phy_rx_clk2} -period 40.000 -waveform { 0.000 20.000 } [list  \
  [get_ports {mii2_rxclk}]]
create_clock -name {phy_tx_clk2} -period 40.000 -waveform { 0.000 20.000 } [list  \
  [get_ports {mii2_txclk}]]
create_clock -name {my_clk2x} -period 4.000 -waveform { 0.000 2.000 } [list  \
  [get_ports {clk_cpu}]]
create_clock -name {my_clk} -period 8.000 -waveform { 0.000 4.000 } [list  \
  [get_ports {clk}]]
create_clock -name {phy_rx_clk1} -period 40.000 -waveform { 0.000 20.000 } [list  \
  [get_ports {mii1_rxclk}]]
create_clock -name {phy_tx_clk1} -period 40.000 -waveform { 0.000 20.000 } [list  \
  [get_ports {mii1_txclk}]]
create_clock -name {pclk} -period 8.000 -waveform { 0.000 4.000 } [list  \
  [get_ports {vid_pclk}]]
create_clock -name {phy_clk} -period 32.000 -waveform { 0.000 16.000 } [list  \
  [get_ports {utmi_phy_clk}]]
## start reading from input constraint file 
current_design \
   {asic_entity} 
set_clock_latency 2.00000 \
   [get_clocks {phy_rx_clk1}] 
set_clock_latency 2.00000 \
   [get_clocks {phy_rx_clk2}] 
set_clock_latency 3.00000 \
   [get_clocks {my_clk}] 
set_clock_latency 2.00000 \
   [get_clocks {my_clk2x}] 
set_clock_latency 2.00000 \
   [get_clocks {pclk}] 
set_clock_latency 2.00000 \
   [get_clocks {phy_clk}] 
set_clock_latency 2.00000 \
   [get_clocks {phy_tx_clk1}] 
set_clock_latency 2.00000 \
   [get_clocks {phy_tx_clk2}] 
set_propagated_clock \
   [get_ports {mii2_rxclk}] 
set_propagated_clock \
   [get_ports {mii1_txclk}] 
set_propagated_clock \
   [get_ports {utmi_phy_clk}] 
set_propagated_clock \
   [get_ports {mii2_txclk}] 
set_propagated_clock \
   [get_ports {clk}] 
set_propagated_clock \
   [get_ports {mii1_rxclk}] 
set_propagated_clock \
   [get_ports {vid_pclk}] 
set_case_analysis 0 \
   [get_ports {scan_enable}] 
set_case_analysis 0 \
   [get_ports {test}] 
